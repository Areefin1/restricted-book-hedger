# Copy to backend/.env. Environment variables override this file.
APP_NAME=Restricted Book Hedger

# Comma-separated frontend origins, including scheme and port.
# Set an empty value to disable cross-origin browser access.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Relative paths are resolved from backend/, regardless of the working directory.
PRICES_PATH=data/prices.csv
METADATA_PATH=data/metadata.json
